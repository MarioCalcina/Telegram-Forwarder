# API ID and API hash are NOT configured here: the console asks for them on the first login
# and keeps them inside the saved session until you log out.
# Get them at https://my.telegram.org (API development tools).

# Name of the saved login file (<name>.session).
TELEGRAM_SESSION_NAME=mi_sesion_telegram

# Optional: default source/destination pair
CHANNEL_ORIGEN_ID=-1001234567890
CHANNEL_DESTINO_ID=-1009876543210

# Optional: multiple pairs as JSON list (has priority if set)
# CHANNEL_MAPPINGS=[{"origen":"-1001111111111","destino":"-1002222222222"}]

MIN_DURACION_VIDEO_MINUTOS=5
EVITAR_DUPLICADOS=True
DELAY_ENTRE_MENSAJES=1.5

MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
MAX_CONCURRENT_VIDEOS=1

ARCHIVO_ESTADO=channel_states.json

ENABLE_NOTIFICATIONS=False
NOTIFICATION_CHAT_ID=
